# Copiar a .env.local para levantar el servidor contra una base LOCAL:
#   npm run dev:local
# En este modo se ignora .env y el servidor no arranca si la base no es local.

# Base local: un PostgreSQL instalado en la PC, con una base vacia "rutina360".
# Usuario y clave: los que se eligieron al instalar PostgreSQL.
# Las tablas y los datos iniciales los crea el servidor al arrancar.
DATABASE_URL=postgres://postgres:CLAVE@localhost:5432/rutina360
DB_SSL=false

PORT=5000
# 127.0.0.1 alcanza para el emulador y para un celular por USB (adb reverse).
# Para un celular por Wi-Fi: HOST=0.0.0.0 y en la app la IP de la PC.
HOST=127.0.0.1

JWT_SECRET=desarrollo-local
JWT_EXPIRES_IN=15m
CORS_ORIGIN=

SUPERADMIN_USER=SUPERADMIN
SUPERADMIN_EMAIL=admin@local.test
SUPERADMIN_PASS=admin123
